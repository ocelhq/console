# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sign-in: at least one method. invite lets only the first user and invited emails sign up.
CONSOLE_EMAIL_AUTH=true
CONSOLE_SIGNUP=open

# Database (PostgreSQL) - see root docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Test database (Vitest test harness) - separate DB on the same local Postgres
# instance; created automatically by the test harness if it doesn't exist yet.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ocelhq_test

# GitHub sign-in (optional; set both to enable it)
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Git integrations (optional)
# Seals git apps' secrets at rest. 32 random bytes, base64: openssl rand -base64 32
CONSOLE_ENCRYPTION_KEY=
# A GitHub App every organization can install. Set all six, or none. On the app, set
#   webhook URL:  {console origin}/api/git/github/system-github/webhooks
#   setup URL:    {console origin}/api/git/github/system-github/setup  (check "Redirect on update")
#   callback URL: {console origin}/api/git/github/system-github/authorized
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Ocel Cloud (optional): offered to the CLI when CONSOLE_CLOUD_URL is set. Leave these
# commented out rather than empty: an empty URL is set, and refused.
# CONSOLE_CLOUD_URL=
# CONSOLE_CLOUD_PROVIDER_URL=
# The aud of the tokens the console signs for Ocel Cloud; the origin of CONSOLE_CLOUD_URL when unset
# CONSOLE_CLOUD_AUDIENCE=

# OIDC issuer (optional): the key targets trust, separate from the session key. Set one; a
# KMS key wins. Leave unused ones commented out rather than empty.
# An AWS KMS ECC_NIST_P256 SIGN_VERIFY key (id, alias or ARN):
# CONSOLE_ISSUER_KMS_KEY_ID=
# A P-256 private key, PEM or JWK:
#   openssl ecparam -name prime256v1 -genkey | openssl pkcs8 -topk8 -nocrypt
# CONSOLE_ISSUER_KEY=
# Retired keys whose public halves stay published after a rotation:
# CONSOLE_ISSUER_PREVIOUS_KMS_KEY_ID=
# CONSOLE_ISSUER_PREVIOUS_KEY=

# Product analytics (optional): pageviews, clicks, errors and session replays go to PostHog
# through the console's /relay path. Nothing is sent unless both are set.
# CONSOLE_POSTHOG_TOKEN=
# CONSOLE_POSTHOG_HOST=https://us.i.posthog.com
