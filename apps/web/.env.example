# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sign-in: at least one method. invite lets only the first user and invited emails sign up.
CONSOLE_EMAIL_AUTH=true
CONSOLE_SIGNUP=open

# Database (PostgreSQL) - see root docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Test database (Vitest test harness) - separate DB on the same local Postgres
# instance; created automatically by the test harness if it doesn't exist yet.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ocelhq_test

# GitHub sign-in (optional; set both to enable it)
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Git integrations (optional)
# Seals git apps' secrets at rest. 32 random bytes, base64: openssl rand -base64 32
CONSOLE_ENCRYPTION_KEY=
# A GitHub App every organization can install. Set all six, or none. On the app, set
#   webhook URL:  {console origin}/api/git/github/system-github/webhooks
#   setup URL:    {console origin}/api/git/github/system-github/setup  (check "Redirect on update")
#   callback URL: {console origin}/api/git/github/system-github/authorized
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
